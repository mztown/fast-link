{
  "name": "Auto Link",
  "description": "拦截 autolinreserved.publicvm.com?wd= 链接，将搜索词按规则转换为 magnet/百度网盘链接，否则跳转百度搜索",
  "version": "2.2",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["redirect.html", "redirect.js", "convert.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "hello.html",
    "default_icon": "hello_extensions.png"
  }
}
