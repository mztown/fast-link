{
  "name": "Auto Link",
  "description": "拦截指定地址（默认 autolinreserved.publicvm.com?wd=），按规则转换为 magnet/百度网盘链接，否则跳转搜索引擎",
  "version": "2.3",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "search",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "hello.html",
    "default_icon": "hello_extensions.png"
  }
}
